---
import { dateLabel, postUrl, tagUrl } from '../lib/posts';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">{posts.map(post => <article class="post-card"><time datetime={dateLabel(post.data.date)}>{dateLabel(post.data.date)}</time><div><h2><a href={postUrl(post.id)}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div></div><a class="read" aria-label={`阅读 ${post.data.title}`} href={postUrl(post.id)}>↗</a></article>)}</div>
