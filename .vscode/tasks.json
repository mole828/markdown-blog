{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kotlin: 运行光标所在代码块",
      "type": "process",
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "${workspaceFolder}/scripts/verify-snippets.mjs",
        "${file}",
        "--line",
        "${lineNumber}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "kotlin-markdown",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Kotlin: 验证当前 Markdown 全部代码块",
      "type": "process",
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "${workspaceFolder}/scripts/verify-snippets.mjs",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "kotlin-markdown",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    }
  ]
}
